<%- include('partials/head') %>
<%- include('partials/navbar') %>

<div class="layout">
  <%- include('partials/sidebar') %>

  <main class="main">
    <%- include('partials/messages') %>

    <div class="eyebrow">Account settings</div>
    <div class="section-head" style="margin-top: 7px;">
      <div>
        <h2>Customer Profile</h2>
        <p>Manage your account details and default delivery address</p>
      </div>
      <% if (currentUser && currentUser.role === 'admin') { %>
        <a href="/admin" class="primary" style="text-decoration:none;">Go to Admin Dashboard</a>
      <% } %>
    </div>

    <div class="two-col">
      <!-- Edit Profile Form -->
      <div class="panel">
        <h3>Profile & Address</h3>
        
        <form action="/auth/profile/update" method="POST">
          <div class="form-group">
            <label>Full Name</label>
            <input type="text" name="name" class="form-control-custom" value="<%= customer.name %>" required>
          </div>

          <div class="form-group">
            <label>Email Address (Read-only)</label>
            <input type="email" class="form-control-custom" value="<%= customer.email %>" readonly style="background:#f4f4f4;">
          </div>

          <div class="form-group">
            <label>Phone Number</label>
            <input type="text" name="phone" class="form-control-custom" value="<%= customer.phone %>">
          </div>

          <div class="form-group">
            <label>Street Address</label>
            <input type="text" name="street" class="form-control-custom" value="<%= customer.address ? customer.address.street : '' %>">
          </div>

          <div class="two-col">
            <div class="form-group">
              <label>City</label>
              <input type="text" name="city" class="form-control-custom" value="<%= customer.address ? customer.address.city : '' %>">
            </div>

            <div class="form-group">
              <label>State</label>
              <input type="text" name="state" class="form-control-custom" value="<%= customer.address ? customer.address.state : '' %>">
            </div>
          </div>

          <div class="form-group">
            <label>PIN / Postal Code</label>
            <input type="text" name="postalCode" class="form-control-custom" value="<%= customer.address ? customer.address.postalCode : '' %>">
          </div>

          <button type="submit" class="primary" style="margin-top: 8px;">
            Save Profile Changes
          </button>
        </form>
      </div>

      <!-- Quick Summary -->
      <div>
        <div class="panel">
          <h3>Account Overview</h3>
          <div class="summaryline">
            <span>Account Type</span>
            <span class="pill <%= customer.role === 'admin' ? 'pending' : '' %>"><%= customer.role.toUpperCase() %></span>
          </div>
          <div class="summaryline">
            <span>Total Orders Placed</span>
            <strong><%= orders.length %></strong>
          </div>
          <div class="summaryline">
            <span>Member Since</span>
            <span><%= formatDate(customer.createdAt) %></span>
          </div>
        </div>

        <div class="panel" style="margin-top: 18px;">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
            <h3 style="margin: 0;">Recent Orders</h3>
            <a href="/orders" class="textlink" style="font-size: 13px;">View all →</a>
          </div>

          <% if (orders && orders.length > 0) { %>
            <div style="display: flex; flex-direction: column; gap: 10px;">
              <% orders.slice(0, 3).forEach(o => { %>
                <div style="display: flex; justify-content: space-between; align-items: center; padding: 10px 0; border-bottom: 1px solid #f0f0f0; font-size: 13px;">
                  <div>
                    <a href="/orders/<%= o._id %>" style="color: var(--orange); font-weight: 700;">
                      <%= o.orderId %>
                    </a>
                    <div style="color: var(--muted); font-size: 11px;"><%= formatDate(o.createdAt) %></div>
                  </div>
                  <div>
                    <span class="pill <%= o.orderStatus === 'Processing' ? 'pending' : (o.orderStatus === 'Shipped' ? 'shipped' : (o.orderStatus === 'Delivered' ? '' : 'cancelled')) %>">
                      <%= o.orderStatus %>
                    </span>
                    <strong style="margin-left: 8px;"><%= formatMoney(o.totalAmount) %></strong>
                  </div>
                </div>
              <% }) %>
            </div>
          <% } else { %>
            <p style="color: var(--muted); font-size: 13px;">No orders placed yet.</p>
          <% } %>
        </div>
      </div>
    </div>

  </main>
</div>

<%- include('partials/footer') %>
