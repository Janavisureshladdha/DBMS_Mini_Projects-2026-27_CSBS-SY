<%- include('../partials/head') %>
<%- include('../partials/navbar') %>

<div class="layout">
  <%- include('../partials/sidebar') %>

  <main class="main">
    <%- include('../partials/messages') %>

    <div class="eyebrow">Category Organization</div>
    <div class="section-head" style="margin-top: 7px;">
      <div>
        <h2>Store Categories (<%= categories.length %>)</h2>
        <p>Manage product departments and browsing taxonomy</p>
      </div>
    </div>

    <div class="two-col">
      <!-- Existing Categories List -->
      <div class="panel">
        <h3>Current Categories</h3>
        
        <div class="tablewrap">
          <table>
            <thead>
              <tr>
                <th>Category</th>
                <th>Products</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% categories.forEach(cat => { %>
                <tr>
                  <td>
                    <span style="font-size: 20px; margin-right: 6px;"><%= cat.icon || '📦' %></span>
                    <strong><%= cat.name %></strong>
                    <div style="font-size: 11px; color: var(--muted);"><%= cat.description %></div>
                  </td>
                  <td>
                    <span class="pill">
                      <%= countMap[cat._id.toString()] || 0 %> products
                    </span>
                  </td>
                  <td>
                    <% if ((countMap[cat._id.toString()] || 0) === 0) { %>
                      <form action="/admin/categories/delete/<%= cat._id %>" method="POST" onsubmit="return confirm('Delete category <%= cat.name %>?');">
                        <button type="submit" class="danger" style="padding: 4px 8px; font-size: 11px;">
                          Delete
                        </button>
                      </form>
                    <% } else { %>
                      <span style="font-size: 11px; color: var(--muted);">Assigned</span>
                    <% } %>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Add Category Form -->
      <div class="panel">
        <h3>Create New Category</h3>
        
        <form action="/admin/categories/add" method="POST">
          <div class="form-group">
            <label>Category Name *</label>
            <input type="text" name="name" class="form-control-custom" placeholder="e.g. Footwear & Apparel" required>
          </div>

          <div class="form-group">
            <label>Icon Emoji</label>
            <input type="text" name="icon" class="form-control-custom" placeholder="👟" value="📦">
          </div>

          <div class="form-group">
            <label>Description</label>
            <textarea name="description" rows="3" class="form-control-custom" placeholder="Brief summary of products in this category..."></textarea>
          </div>

          <button type="submit" class="primary full" style="padding: 12px; margin-top: 10px;">
            Add Category
          </button>
        </form>
      </div>
    </div>

  </main>
</div>

<%- include('../partials/footer') %>
